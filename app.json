{
  "expo": {
    "name": "Pangasinan Heritage Guide",
    "slug": "pangasinan-heritage-guide",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "pangasinanheritageguide",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F5EF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.pangasinan.heritageguide",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D3B66"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "d3ad0d54-83d4-45ad-8ad7-d583d569374b"
      }
    }
  }
}
